# @vercel/analytics@2.0.1 (latest) declares peerOptional vue-router@^4, but this
# project runs vue-router@5. The package only uses the router to observe route
# changes, which is unchanged in v5, so the constraint is stale rather than real.
# Without this, a clean `npm ci` / CI install fails on ERESOLVE.
# Revisit once @vercel/analytics widens the peer range.
legacy-peer-deps=true
